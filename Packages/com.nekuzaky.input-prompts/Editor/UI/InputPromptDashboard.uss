/* Dark dashboard theme, independent from the editor skin. */

.ip-root {
    flex-grow: 1;
    background-color: rgb(22, 24, 29);
}

/* ---------------------------------------------------------------- header */

.ip-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    background-color: rgb(29, 32, 39);
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 49, 59);
}

/* min-width 0 lets the block shrink instead of pushing the buttons out of the window. */
.ip-header__titles {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.ip-header__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ip-title {
    font-size: 17px;
    color: rgb(233, 236, 243);
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ip-subtitle {
    font-size: 11px;
    color: rgb(139, 146, 162);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ---------------------------------------------------------------- pills */

.ip-pill {
    padding: 4px 10px;
    border-radius: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 8px;
    background-color: rgb(40, 44, 53);
    color: rgb(190, 196, 209);
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.ip-pill--ok {
    background-color: rgba(61, 220, 132, 0.16);
    color: rgb(93, 226, 150);
}

.ip-pill--warn {
    background-color: rgba(255, 176, 32, 0.16);
    color: rgb(255, 190, 74);
}

.ip-pill--error {
    background-color: rgba(255, 92, 92, 0.16);
    color: rgb(255, 122, 122);
}

/* ---------------------------------------------------------------- buttons */

.ip-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 26px;
    padding: 0 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(56, 61, 73);
    background-color: rgb(43, 47, 57);
    color: rgb(222, 226, 235);
    font-size: 12px;
    margin: 0 0 0 6px;
}

.ip-button:hover {
    background-color: rgb(52, 57, 69);
    border-color: rgb(72, 79, 94);
}

.ip-button__text {
    -unity-text-align: middle-center;
    overflow: hidden;
    white-space: nowrap;
}

.ip-button--primary {
    background-color: rgb(58, 128, 232);
    border-color: rgb(78, 148, 252);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.ip-button--primary:hover {
    background-color: rgb(72, 142, 246);
}

.ip-button--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: rgb(150, 157, 172);
}

.ip-button--ghost:hover {
    background-color: rgb(40, 44, 53);
    color: rgb(222, 226, 235);
}

.ip-button--coffee {
    background-color: rgba(255, 176, 32, 0.14);
    border-color: rgba(255, 176, 32, 0.45);
    color: rgb(255, 196, 92);
}

.ip-button--coffee:hover {
    background-color: rgba(255, 176, 32, 0.24);
    color: rgb(255, 214, 140);
}

/* ---------------------------------------------------------------- glyphs */

.ip-glyph {
    width: 15px;
    height: 15px;
    margin-right: 7px;
    flex-shrink: 0;
}

.ip-glyph--title {
    width: 22px;
    height: 22px;
    margin-right: 10px;
}

.ip-button .ip-glyph {
    margin-right: 5px;
}

/* ---------------------------------------------------------------- layout */

.ip-body {
    flex-grow: 1;
    padding: 12px;
}

.ip-columns {
    flex-direction: row;
    flex-wrap: wrap;
}

.ip-column {
    flex-grow: 1;
    flex-basis: 320px;
    min-width: 260px;
}

/* ---------------------------------------------------------------- cards */

.ip-card {
    background-color: rgb(30, 33, 40);
    border-width: 1px;
    border-color: rgb(45, 49, 59);
    border-radius: 10px;
    margin: 0 6px 12px 6px;
    overflow: hidden;
}

.ip-card__header {
    flex-direction: row;
    align-items: center;
    padding: 9px 12px;
    background-color: rgb(34, 37, 45);
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 49, 59);
}

.ip-card__title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(226, 230, 239);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ip-card__hint {
    font-size: 10px;
    color: rgb(122, 129, 145);
    flex-shrink: 0;
    margin-left: 8px;
}

.ip-card__content {
    padding: 10px 12px;
}

/* ---------------------------------------------------------------- fields */

.ip-field {
    margin-bottom: 8px;
    flex-shrink: 1;
    min-width: 0;
}

.ip-field .unity-base-field__label {
    min-width: 96px;
    max-width: 140px;
    flex-shrink: 0;
    color: rgb(168, 175, 190);
    font-size: 11px;
}

.ip-field .unity-base-field__input {
    background-color: rgb(24, 26, 32);
    border-width: 1px;
    border-color: rgb(52, 57, 68);
    border-radius: 5px;
    color: rgb(226, 230, 239);
    padding: 3px 6px;
    min-width: 0;
}

.ip-field .unity-base-field__input:focus {
    border-color: rgb(58, 128, 232);
}

.ip-row {
    flex-direction: row;
    align-items: center;
}

.ip-row__grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ip-note {
    font-size: 10px;
    color: rgb(122, 129, 145);
    white-space: normal;
    margin-top: 4px;
}

.ip-note--warn {
    color: rgb(255, 190, 74);
}

/* ---------------------------------------------------------------- devices */

.ip-device {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-radius: 6px;
    margin-bottom: 3px;
    background-color: rgb(26, 29, 35);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.ip-device:hover {
    background-color: rgb(35, 39, 47);
}

.ip-device--selected {
    border-color: rgb(58, 128, 232);
    background-color: rgba(58, 128, 232, 0.10);
}

.ip-device__badge {
    width: 14px;
    height: 14px;
    margin-right: 9px;
    flex-shrink: 0;
}

.ip-device__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    color: rgb(226, 230, 239);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ip-device__layout {
    font-size: 10px;
    color: rgb(122, 129, 145);
    margin-right: 8px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
}

.ip-device__count {
    font-size: 11px;
    color: rgb(150, 157, 172);
    min-width: 62px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

/* ---------------------------------------------------------------- preview */

.ip-preview {
    flex-direction: row;
    flex-wrap: wrap;
}

.ip-tile {
    width: 74px;
    align-items: center;
    padding: 8px 4px;
    margin: 4px;
    border-radius: 8px;
    background-color: rgb(26, 29, 35);
    border-width: 1px;
    border-color: rgb(43, 47, 57);
}

.ip-tile--missing {
    border-color: rgb(84, 60, 60);
    background-color: rgba(255, 92, 92, 0.06);
}

.ip-tile__icon {
    width: 42px;
    height: 42px;
}

.ip-tile__label {
    font-size: 9px;
    color: rgb(139, 146, 162);
    margin-top: 6px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------------------------------------------------------------- report */

.ip-report {
    min-height: 110px;
    max-height: 240px;
}

.ip-report__text {
    flex-grow: 1;
}

.ip-report .unity-base-text-field__input {
    background-color: rgb(19, 21, 26);
    border-width: 1px;
    border-color: rgb(45, 49, 59);
    border-radius: 6px;
    color: rgb(168, 175, 190);
    font-size: 11px;
}

/* ---------------------------------------------------------------- footer */

.ip-footer {
    flex-direction: row;
    align-items: center;
    padding: 7px 16px;
    background-color: rgb(29, 32, 39);
    border-top-width: 1px;
    border-top-color: rgb(45, 49, 59);
}

.ip-footer__text {
    font-size: 10px;
    color: rgb(112, 119, 134);
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ip-footer__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- responsive */

/* Under the breakpoint the header and the footer stack instead of overlapping. */
.ip-header--compact {
    flex-direction: column;
    align-items: stretch;
}

.ip-header--compact .ip-header__actions {
    margin-top: 10px;
}

.ip-header--compact .ip-subtitle {
    display: none;
}

.ip-header--compact .ip-button {
    flex-grow: 1;
    margin: 0 0 0 6px;
}

.ip-footer--compact {
    flex-direction: column;
    align-items: stretch;
}

.ip-footer--compact .ip-footer__text {
    white-space: normal;
    margin-bottom: 6px;
}

.ip-footer--compact .ip-button {
    flex-grow: 1;
    margin: 0 0 0 6px;
}

.ip-columns--compact .ip-column {
    flex-basis: 100%;
    min-width: 0;
}

.ip-columns--compact .ip-device__layout {
    display: none;
}

/* ---------------------------------------------------------------- validation */

.ip-issue {
    font-size: 10px;
    color: rgb(139, 146, 162);
    white-space: normal;
    padding: 4px 8px;
    margin-top: 3px;
    border-radius: 5px;
    background-color: rgb(26, 29, 35);
    border-left-width: 2px;
    border-left-color: rgb(70, 76, 90);
}

.ip-issue--missing {
    color: rgb(255, 196, 92);
    border-left-color: rgb(255, 176, 32);
}
